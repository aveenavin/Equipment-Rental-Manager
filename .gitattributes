# =============================================================================
# Equipment Rental Manager — .gitattributes
# Enforce consistent line endings across Windows, macOS, and Linux.
# =============================================================================

# Default: normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly declare source files as text
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf

# Windows-specific scripts keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — prevent line-ending corruption
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.svg       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.tar.gz    binary
*.mp4       binary
*.mp3       binary

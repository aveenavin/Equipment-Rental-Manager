NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/equipment_rental_manager

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Client URL (for CORS and email verification links)
CLIENT_URL=http://localhost:5173

# Resend (https://resend.com)
# 1. Sign up at resend.com and get your API key from the dashboard.
# 2. Verify your sending domain (or use onboarding@resend.dev for testing).
# 3. Paste your API key below — it starts with "re_".
RESEND_API_KEY=re_your_api_key_here

# The "from" address shown in the recipient's inbox.
# Must be on a domain you have verified in your Resend dashboard.
# For testing without a domain, use: onboarding@resend.dev
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=EquipRental

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/equipment_rental_manager

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client URL (for CORS and email verification links)
CLIENT_URL=http://localhost:5173

# Nodemailer – Gmail SMTP
# ---------------------------------------------------------------
# SMTP_HOST   : Leave as smtp.gmail.com for Gmail.
# SMTP_PORT   : 465 for SSL (recommended) or 587 for STARTTLS.
# SMTP_USER   : Your full Gmail address (e.g. you@gmail.com).
# SMTP_PASS   : A Gmail App Password – NOT your account password.
#               Steps to generate one:
#               1. Go to https://myaccount.google.com/security
#               2. Enable 2-Step Verification if not already on.
#               3. Go to https://myaccount.google.com/apppasswords
#               4. Choose "Mail" + your device, then click Generate.
#               5. Paste the 16-character code here (no spaces).
# SMTP_FROM   : The "From" field shown in the recipient's inbox.
#               Must match SMTP_USER for Gmail.
# ---------------------------------------------------------------
#brevo
BREVO_API_KEY=***
BREVO_SENDER_EMAIL=<example@gmail.com>
BREVO_SENDER_NAME=EquipRental
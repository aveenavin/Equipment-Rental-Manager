# =============================================================================
#Rental Management Platform— Backend Production Environment Variables
# =============================================================================
# Copy this file to .env on your hosting platform's secret/env settings.
# NEVER commit real values to Git.
# =============================================================================

NODE_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# MongoDB Atlas
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/equipment_rental_manager?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT — Use long, random, unique secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Client URL — Your deployed frontend URL (no trailing slash)
# For multiple origins: comma-separate them, e.g. https://app.com,https://www.app.com
# -----------------------------------------------------------------------------
CLIENT_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# Cookie SameSite Policy
# Set to 'none' when frontend and backend are on DIFFERENT domains (cross-site).
# Omit or set to 'strict' when both are on the SAME domain.
# 'none' requires HTTPS (automatically satisfied in production).
# -----------------------------------------------------------------------------
COOKIE_SAME_SITE=none

# -----------------------------------------------------------------------------
# Cloudinary — Image storage for equipment photos
# Dashboard: https://cloudinary.com/console
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

#brevo
BREVO_API_KEY=***
BREVO_SENDER_EMAIL=<73aveen@gmail.com>
BREVO_SENDER_NAME=RentAll

# -----------------------------------------------------------------------------
# Admin Account — Created automatically on first startup
# Change these before first deploy!
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# -----------------------------------------------------------------------------
# Seed Data — Set to 'false' in production to skip demo data seeding
# -----------------------------------------------------------------------------
SEED_DATA=false

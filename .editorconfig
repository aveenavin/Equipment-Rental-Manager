# =============================================================================
# Equipment Rental Manager — .editorconfig
# Ensures consistent formatting across all editors and IDEs.
# See: https://editorconfig.org
# =============================================================================

root = true

# --- All Files ---
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# --- JavaScript & JSX ---
[*.{js,jsx,ts,tsx}]
indent_size = 2

# --- JSON ---
[*.json]
indent_size = 2

# --- CSS ---
[*.css]
indent_size = 2

# --- Markdown (preserve trailing spaces — used for line breaks) ---
[*.md]
trim_trailing_whitespace = false

# --- YAML ---
[*.{yml,yaml}]
indent_size = 2

# --- Windows Batch Scripts ---
[*.{bat,cmd}]
end_of_line = crlf
